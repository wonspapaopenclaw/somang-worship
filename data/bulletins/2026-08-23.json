          "reading": {
            "number": 77,
            "reference": "요한복음 3장",
            "title": "요한복음 3장",
            "lines": [
              {
                "speaker": "leader",
                "text": "하나님이 세상을 이처럼 사랑하사 독생자를 주셨으니"
              },
              {
                "speaker": "congregation",
                "text": "이는 그를 믿는 자마다 멸망하지 않고 영생을 얻게 하려 하심이라"
              },
              {
                "speaker": "leader",
                "text": "하나님이 그 아들을 세상에 보내신 것은"
              },
              {
                "speaker": "congregation",
                "text": "세상을 심판하려 하심이 아니요"
              },
              {
                "speaker": "leader",
                "text": "그로 말미암아 세상이 구원을 받게 하려 하심이라"
              },
              {
                "speaker": "congregation",
                "text": "그를 믿는 자는 심판을 받지 아니하는 것이요"
              },
              {
                "speaker": "leader",
                "text": "믿지 아니하는 자는 하나님의 독생자의 이름을 믿지 아니하므로"
              },
              {
                "speaker": "congregation",
                "text": "벌써 심판을 받은 것이니라"
              },
              {
                "speaker": "leader",
                "text": "그 정죄는 이것이니 곧 빛이 세상에 왔으되"
              },
              {
                "speaker": "congregation",
                "text": "사람들이 자기 행위가 악하므로 빛보다 어둠을 더 사랑한 것이니라"
              },
              {
                "speaker": "leader",
                "text": "악을 행하는 자마다 빛을 미워하여 빛으로 오지 아니하나니"
              },
              {
                "speaker": "congregation",
                "text": "이는 그 행위가 드러날까 함이요"
              },
              {
                "speaker": "leader",
                "text": "진리를 따르는 자는 빛으로 오나니"
              },
              {
                "speaker": "congregation",
                "text": "이는 그 행위가 하나님 안에서 행한 것임을 나타내려 함이라 하시니라"
              }
            ]
          },
          "participant": "앉아서"
